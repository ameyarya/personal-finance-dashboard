#!/usr/bin/env python3
"""Refuse a push when any commit about to leave this computer contains personal information."""
import subprocess
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "tools"))
import privacy_scan

ZERO = "0" * 40
status = 0
terms = privacy_scan.load_terms()
for line in sys.stdin:
    parts = line.split()
    if len(parts) < 4 or parts[1] == ZERO:        # deleting a branch: nothing to scan
        continue
    local, remote = parts[1], parts[3]
    rng = [local, "--not", "--remotes"] if remote == ZERO else [remote + ".." + local]
    status |= privacy_scan.report(privacy_scan.scan_range(rng, terms))
sys.exit(status)
