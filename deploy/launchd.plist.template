<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace /PATH/TO/personal-finance-dashboard (twice) with where you cloned this repository. -->
<plist version="1.0"><dict>
  <key>Label</key><string>local.finance-dashboard</string>
  <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>-u</string><string>/PATH/TO/personal-finance-dashboard/server.py</string></array>
  <key>WorkingDirectory</key><string>/PATH/TO/personal-finance-dashboard</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/tmp/finance-dashboard.log</string>
  <key>StandardErrorPath</key><string>/tmp/finance-dashboard.log</string>
</dict></plist>
